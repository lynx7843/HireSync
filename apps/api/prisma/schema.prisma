generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

enum ApplicationStatus {
  applied
  screening
  interview
  offer
  hired
  rejected
}

model Candidate {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  email        String        @unique
  phone        String?
  location     String?
  linkedin_url String?
  notes        String?
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  deleted_at   DateTime?     // Required for soft delete

  applications Application[]

  // Cross-entity search fields. These are queried with `contains` +
  // `mode: 'insensitive'` (ILIKE '%term%'), which a B-tree index cannot serve
  // because of the leading wildcard — hence trigram GIN indexes.
  // The @unique on email keeps its own B-tree for uniqueness/exact lookups.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([location(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Application {
  id                 String            @id @default(uuid()) @db.Uuid
  candidate_id       String            @db.Uuid
  job_title          String
  company            String
  status             ApplicationStatus @default(applied)
  applied_at         DateTime          @db.Date
  salary_expectation Int?
  source             String?
  notes              String?
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  deleted_at         DateTime?         // Soft delete, same model as Candidate

  candidate Candidate @relation(fields: [candidate_id], references: [id])

  // Search fields: ILIKE '%term%', so trigram GIN (see Candidate above).
  @@index([job_title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([company(ops: raw("gin_trgm_ops"))], type: Gin)
  // source is OR'd into the same search; without its own index the whole OR
  // falls back to a sequential scan.
  @@index([source(ops: raw("gin_trgm_ops"))], type: Gin)
  // Filter fields: equality / range, which B-tree serves correctly.
  @@index([status])
  @@index([applied_at])
}