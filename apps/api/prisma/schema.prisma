generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  applied
  screening
  interview
  offer
  hired
  rejected
}

model Candidate {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  email        String        @unique
  phone        String?
  location     String?
  linkedin_url String?
  notes        String?
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  deleted_at   DateTime?     // Required for soft delete

  applications Application[]

  // Indexes for cross-entity search fields
  @@index([name])
  @@index([email])
  @@index([location])
}

model Application {
  id                 String            @id @default(uuid()) @db.Uuid
  candidate_id       String            @db.Uuid
  job_title          String
  company            String
  status             ApplicationStatus @default(applied)
  applied_at         DateTime          @db.Date
  salary_expectation Int?
  source             String?
  notes              String?
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt

  candidate Candidate @relation(fields: [candidate_id], references: [id])

  // Indexes for application search and filtering fields
  @@index([job_title])
  @@index([company])
  @@index([status])
  @@index([applied_at])
}