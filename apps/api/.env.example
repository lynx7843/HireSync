# Copy to apps/api/.env and fill in real values.

# Required
DATABASE_URL="postgresql://dev:dev@localhost:5433/candidate_tracker"
JWT_SECRET="replace-with-a-random-string-of-at-least-32-characters"
AUTH_EMAIL="you@example.com"

# Set one of these. AUTH_PASSWORD (plaintext) is for local development only.
AUTH_PASSWORD="local-dev-password"
# AUTH_PASSWORD_HASH=""

# Optional
# AUTH_TOKEN_TTL=28800
# PORT=3001
# HOST=127.0.0.1
# CORS_ORIGINS="http://localhost:5173"
